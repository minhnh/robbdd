import "pickplace_table_custom.bdd"
import "lab.scenex"

ns bdd_exec='https://secorolab.github.io/models/acceptance-criteria/bdd/executions/'
ns bdd_exec_ros='https://secorolab.github.io/models/acceptance-criteria/bdd/executions/ros/'

bhv impl (ns=bdd_exec_ros) mockup-pp-server {
    bhv action: "/bdd/mockup_bhv_server"
}

obs provider (ns=bdd_exec_ros) entity-state {
    ros simulation entity state
    update-rate: 10 Hz
}
obs provider (ns=bdd_exec_ros) recognized-poses {
    ros topic: "/recognized_poses"
    type: "geometry_msgs/msg/PoseArray"
}

observation (ns=bdd_exec_ros) object-pose {
    provider: <entity-state>
    observes var <tmpl_pickplace.target_object>
    time extractor: py { module: bdd_exec_ros2.observation, attr: latest_identified_pose_stamp }
    entity mapper: py { module: bdd_exec_ros2.observation, attr: map_identified_pose_batch }
}
observation (ns=bdd_exec_ros) workspace-pose {
    provider: <entity-state>
    observes var <tmpl_pickplace.place_ws>
    time extractor: py { module: bdd_exec_ros2.observation, attr: latest_identified_pose_stamp }
    entity mapper: py { module: bdd_exec_ros2.observation, attr: map_identified_pose_batch }
}

obs policy (ns=bdd_exec_ros) fcx-located-after-distance
    for <tmpl_pickplace.fc-located-after>
    horizon: 0.5 seconds
{
    observations: { <object-pose>, <workspace-pose> }
    evaluator: linear distance {
        equals: 0.10 m tolerance: 0.01 m
    }
}

Scenario Exec (ns=bdd_exec) pickplace-observations {
    variant: <sim_pickplace.pickplace_table>
    scene inst: <pickplace_scene_mjc>
    bhv: <mockup-pp-server>
    policies: { <fcx-located-after-distance> }
}
