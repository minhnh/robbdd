import base
import bdd
reference scenex as sx

Model:
imports*=Import

namespaces=NamespaceDeclare*

(
bhv_impls+=BehaviourImplementation
|
obs_policies+=ObservationPolicy
|
obs_providers+=ObservationProvider
)*

scenario_execs+=ScenarioExecution
;

ScenarioExecution:
'Scenario' 'Exec' '(' 'ns' '=' ns=[NamespaceDeclare|FQN] ')' name=IRI_TRUNK '{'
  'variant' ':' '<' variant=[ScenarioVariant|FQN] '>'
  'scene' 'inst' ':' '<' scene_inst=[sx.SceneInstance|FQN] '>'
  'bhv' ':' '<' bhv_impl=[BehaviourImplementation|FQN] '>'
  'policies' ':' '{'
    ('<' obs_policies=[ObservationPolicy|FQN] '>')+[',']
  '}'
'}'
;

BehaviourImplementation:
'bhv' 'impl' '(' 'ns' '=' ns=[NamespaceDeclare|FQN] ')' name=IRI_TRUNK '{'
  bhv_spec=BhvImplSpec
'}'
;
BhvImplSpec: RosBhvAction | PyModuleAttr ;

ObservationProvider:
'obs' 'provider' '(' 'ns' '=' ns=[NamespaceDeclare|FQN] ')' name=IRI_TRUNK '{'
  provider_spec=ProviderSpec
'}'
;

ObservationPolicy:
'obs' 'policy' '(' 'ns' '=' ns=[NamespaceDeclare|FQN] ')' name=IRI_TRUNK
  'for' fluent_ref=HoldsExprRef '{'
  observations+=Observation*
  policy_spec=PolicySpec
'}'
;

ProviderSpec: RosTopicProvider | SimulationEntityStateProvider ;
RosTopicProvider:
  'ros' 'topic' ':' topic_name=STRING
  'type' ':' type_name=STRING
;
SimulationEntityStateProvider:
  'ros' 'simulation' 'entity' 'state'
  'update-rate' ':' update_rate=FLOAT 'Hz'
;

Observation:
  'observation' name=IRI_TRUNK '{'
  'provider' ':' '<' provider=[ObservationProvider|FQN] '>'
  ('observes' ':' '<' target=[bdd.VariableBase|FQN] '>')?
  '}'
;

PolicySpec: RosTrinaryTopic | LinearDistanceObservation | PyModuleAttr ;
LinearDistanceObservation:
  'linear' 'distance' 'between' '<' left=[Observation|FQN] '>'
  'and' '<' right=[Observation|FQN] '>' '{'
  constraint=DistanceConstraint
  '}'
;
DistanceConstraint:
  ('less-than' ':' less_than=DistanceValue
  | 'greater-than' ':' greater_than=DistanceValue
  | 'between' ':' lower=DistanceValue 'and' upper=DistanceValue
  | 'equals' ':' equals=DistanceValue 'tolerance' ':' tolerance=DistanceValue)
;
LengthUnit: 'mm' | 'cm' | 'm' ;
DistanceValue: value=FLOAT unit=LengthUnit ;

RosBhvAction: 'bhv' 'action' ':' action_name=STRING ;
RosTrinaryTopic: 'trinary' 'topic' ':' topic_name=STRING ;
